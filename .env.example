# ============ Base de datos ============
# Desarrollo local (SQLite):  file:./dev.db
# Producción (PostgreSQL / Neon): postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="file:./dev.db"

# ============ Autenticación (NextAuth) ============
NEXTAUTH_URL="http://localhost:3000"          # En producción: https://tu-dominio.com
NEXTAUTH_SECRET=""                            # Generar con: openssl rand -base64 32
NEXT_PUBLIC_SITE_URL="http://localhost:3000"  # Usado por sitemap/robots/SEO

# ============ Pagos: Niubiz ============
NIUBIZ_ENV="sandbox"                          # sandbox | production
NIUBIZ_MERCHANT_ID=""
NIUBIZ_USER=""
NIUBIZ_PASSWORD=""

# ============ Cron (expiración de pedidos sin pagar) ============
CRON_SECRET=""                                # Vercel lo envía como Authorization: Bearer <CRON_SECRET>

# ============ Emails (Resend) ============
RESEND_API_KEY=""
EMAIL_FROM="Aura Tech <pedidos@tu-dominio.com>"
